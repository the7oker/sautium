# The CPU image of a Linux host — Docker on an Apple Silicon Mac
# (docker-compose.mac.yml), a Raspberry Pi 5 or an x86-64 machine with no
# NVIDIA card (docker-compose.pi.yml); no CUDA. The architecture is the
# build's own (TARGETARCH: arm64 or amd64).
#
# Three build arguments say what the image carries (PI-NODE-2B; the console
# setup records them in .env, and the host agent's update builds with the same):
#   MODELS=0         no model stack (requirements-ml.txt): the node analyses
#                    nothing and embeds no query, whatever its switches say
#   ASSISTANT_CLI=0  no Node.js and no Claude Code CLI
#   STREAMING=0      no deno (yt-dlp's sandbox for the demo channel)
# The node reads what its image has at its start and says "this install was
# set up without it" where a screen would offer it. No variant carries the
# compilers: the packages are installed in a build stage and copied.
#
# Ubuntu 22.04, the release image's own base: the fingerprint (fpcalc over
# FFmpeg's decode) is the content address of every analysis record, and only
# the same FFmpeg gives the same fingerprints — Debian trixie's FFmpeg 7.1
# changed 17 of 90 synthetic test files, bookworm's fpcalc exits 3 on every
# track under 120 s (measured on a Raspberry Pi 5, 2026-11-09). A move of the base off FFmpeg 4.4 is a design
# question first: the self-test (provenance.fingerprinter) refuses analysis
# on an fpcalc that fingerprints its probe signal wrong or not at all, but
# FFmpeg 7.1 moves a file's print one time in five, and its probe's not.
#
# The base is named by its digest (Docker Hub's index for ubuntu:22.04): a
# base that moves reaches nodes in a release, as every other pin does.
# Python is CPython built from python.org's source in a stage of its own
# (jammy's own python3.11 is 3.11.0rc1): no build of this image rests on a
# package archive with no pin and no second source, as the deadsnakes PPA
# was (IMAGE-BUILD-1: two of five builds on a Raspberry Pi failed on its
# 503). The stage's layer is reused until the pin below moves.
FROM ubuntu:22.04@sha256:b000e69a50ff940390233025e7a337fb8469b509e2334fa4d018ac30f3e18cdb AS os

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive


# -- CPython, built once per pin ---------------------------------------------
FROM os AS python

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config curl ca-certificates xz-utils \
    libssl-dev zlib1g-dev libbz2-dev liblzma-dev libsqlite3-dev libffi-dev uuid-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Debian's level of optimisation (PGO + LTO): an interpreter as fast as the
# distributions' (python-build-standalone's ran bytecode 30-45 % slower,
# measured). No readline and no gdbm headers: the interpreter links no GPL
# library. The tests are left out of the install.
ARG CPYTHON_VERSION=3.11.18
ARG CPYTHON_SHA256=9120e0a653868f6e3698d36cdd99e5a58903ec9469e448f21d98f7b16d8fa290
RUN curl -fsSLo /tmp/python.tar.xz \
        https://www.python.org/ftp/python/${CPYTHON_VERSION}/Python-${CPYTHON_VERSION}.tar.xz \
    && echo "${CPYTHON_SHA256}  /tmp/python.tar.xz" | sha256sum -c - \
    && mkdir /tmp/python && tar -xJf /tmp/python.tar.xz -C /tmp/python --strip-components=1 \
    && cd /tmp/python \
    && ./configure --prefix=/usr/local --enable-shared --enable-optimizations --with-lto \
        --enable-loadable-sqlite-extensions --without-ensurepip --enable-option-checking=fatal \
        LDFLAGS=-Wl,-rpath,/usr/local/lib \
    && make -j"$(nproc)" \
    && make install \
    && cd / && rm -rf /tmp/python /tmp/python.tar.xz \
    && find /usr/local/lib/python3.11 -depth -type d -name test -prune -exec rm -rf '{}' + \
    && find /usr/local -name 'libpython*.a' -delete \
    && find /usr/local/lib/python3.11 -name '*.opt-[12].pyc' -delete \
    && find /usr/local/lib -name '*.so*' -type f -exec strip --strip-unneeded '{}' + \
    && ln -s python3 /usr/local/bin/python \
    && /usr/local/bin/python3 -c "import ssl, sqlite3, ctypes, lzma, bz2, zlib, uuid, decimal, hashlib"


# -- what the node runs on ----------------------------------------------------
FROM os AS base

ENV PYTHON_VERSION=3.11

RUN apt-get update && apt-get install -y --no-install-recommends \
    # The interpreter's own libraries (the python stage built against them),
    # and the MIME table its mimetypes reads (the Web UI's fonts are served
    # by type)
    media-types \
    libssl3 \
    zlib1g \
    libbz2-1.0 \
    liblzma5 \
    libsqlite3-0 \
    libffi8 \
    libuuid1 \
    # Audio processing libraries
    ffmpeg \
    libsndfile1 \
    # OpenMP's runtime, for the wheels that do not bundle their own
    libgomp1 \
    # Chromaprint fpcalc — the content address of every analysis record
    # (provenance.require_fingerprinter refuses an analysis pass without it)
    libchromaprint-tools \
    # Parallel bzip2 for the MusicBrainz dump (mb_dump_load falls back to bzip2)
    lbzip2 \
    git \
    wget \
    curl \
    ca-certificates \
    # Node's archive is .tar.xz
    xz-utils \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# After the packages: a pin's move rebuilds nothing above it
COPY --from=python /usr/local/ /usr/local/


# -- the build stage: compilers and headers, left behind -----------------------
FROM base AS build

# Every file fetched with curl in this file names its version and is checked
# against its SHA-256 before it is unpacked or run; a version moves with its
# digest, in a release. (The pip installs of this stage resolve from PyPI at
# build time.)

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1-dev \
    build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# pip from its wheel, checked by digest (the release image's way)
ARG PIP_WHEEL=pip-26.2.2-py3-none-any.whl
ARG PIP_URL=https://files.pythonhosted.org/packages/3f/06/3e4420302363fbb71be3c7f35ce042f54bfca330e3e66b3a2e3c4cca579f/pip-26.2.2-py3-none-any.whl
ARG PIP_SHA256=fd7f4dfa8190e014013b9f08f3e973f4e4c26ffd179a204895533a7254813a70
RUN curl -fsSLo /tmp/${PIP_WHEEL} ${PIP_URL} \
    && echo "${PIP_SHA256}  /tmp/${PIP_WHEEL}" | sha256sum -c - \
    && python${PYTHON_VERSION} /tmp/${PIP_WHEEL}/pip install --no-index /tmp/${PIP_WHEEL} \
    && rm /tmp/${PIP_WHEEL} \
    && python${PYTHON_VERSION} -m pip install setuptools==78.1.1 wheel==0.48.0

WORKDIR /build

# Copy requirements first for better Docker layer caching
COPY requirements.txt requirements-ml.txt ./

ARG MODELS=1

# PyTorch CPU-only (no CUDA in this image): this avoids downloading ~2GB of
# CUDA libraries. Its own layer, so an edit of a requirements file downloads
# no torch again.
RUN if [ "${MODELS}" = 1 ]; then \
        pip install --no-cache-dir torch==2.12.0 torchvision==0.27.0 torchaudio==2.11.0 \
            --index-url https://download.pytorch.org/whl/cpu; \
    fi

# The node's packages, and with MODELS=1 the model stack beside them in one
# resolution (torch already installed above, pip will skip it)
RUN if [ "${MODELS}" = 1 ]; then \
        pip install --no-cache-dir -r requirements.txt -r requirements-ml.txt; \
    else \
        pip install --no-cache-dir -r requirements.txt; \
    fi

# cutlet's Japanese dictionary (transliterate.py degrades without it), as the release image has it
RUN pip install --no-cache-dir unidic-lite==1.0.8 && touch /usr/local/etc/mecabrc

# libtorrent for the DHT's peer discovery. Its wheels exist for both
# architectures, so a failure here is a download's, and an image without it
# would be a node that silently finds no peers: the build fails instead.
RUN pip install --no-cache-dir "libtorrent>=2.0.15"


# -- the image -----------------------------------------------------------------
FROM base

# BuildKit names the architecture; the classic builder leaves it empty, and
# the two downloads below then ask dpkg
ARG TARGETARCH
ARG ASSISTANT_CLI=1
ARG STREAMING=1

# Node.js 22, the official build (for the Claude Code CLI)
ARG NODE_VERSION=22.23.2
ARG NODE_SHA256_ARM64=fff4078c5def658577f92c88db7db3bc0072924bfb93fe52c1e744a54e94abb8
ARG NODE_SHA256_AMD64=d60acfe00a2932254bb0ad20e01b0d74397a0875595de719654b214f4b03f307
RUN if [ "${ASSISTANT_CLI}" = 1 ]; then \
        case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
            arm64) node_arch=arm64; node_sha256="${NODE_SHA256_ARM64}" ;; \
            amd64) node_arch=x64; node_sha256="${NODE_SHA256_AMD64}" ;; \
            *) echo "no Node.js digest for this architecture" >&2; exit 1 ;; \
        esac \
        && curl -fsSLo /tmp/node.tar.xz \
            https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz \
        && echo "${node_sha256}  /tmp/node.tar.xz" | sha256sum -c - \
        && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 --no-same-owner \
        && rm /tmp/node.tar.xz && node --version; \
    fi

# The Claude Code CLI at the exact version and integrity hashes its lockfile
# names (agents/claude-code/package-lock.json): it moves with a release, never
# at a container's start, and its own updater stays off.
COPY agents/claude-code/ /opt/agents/claude-code/
RUN if [ "${ASSISTANT_CLI}" = 1 ]; then \
        npm ci --prefix /opt/agents/claude-code --no-audit --no-fund && npm cache clean --force; \
    fi
ENV PATH=/opt/agents/claude-code/node_modules/.bin:$PATH
ENV DISABLE_AUTOUPDATER=1

# The node's user: the backend and the agent CLI run as it. The image's
# entrypoint (node_user.py, root's, outside /app — which that user can write)
# hands it the node's folders and drops root, then runs the command.
RUN useradd -m -s /bin/bash agent \
    && mkdir -p /home/agent/.claude/debug \
    && mkdir -p /home/agent/.claude/projects \
    && echo '{}' > /home/agent/.claude/settings.json \
    && mkdir -p /home/agent/.cache \
    && chown -R agent:agent /home/agent/.claude /home/agent/.cache
COPY node_user.py /usr/local/lib/sautium/node_user.py
ENTRYPOINT ["python3", "-I", "-S", "/usr/local/lib/sautium/node_user.py"]

# The packages the build stage installed (pip, the libraries, their scripts,
# the dictionary's mecabrc): everything pip wrote lives under /usr/local
COPY --from=build /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=build /usr/local/bin/ /usr/local/bin/
COPY --from=build /usr/local/etc/mecabrc /usr/local/etc/mecabrc

# Set working directory
WORKDIR /app

# deno: the sandboxed JS runtime yt-dlp solves YouTube's player challenges in
# (yt-dlp itself the node installs into its cache: streaming/ytdlp_release.py)
ARG DENO_VERSION=2.9.8
ARG DENO_SHA256_ARM64=d49596c20b9788cf8f5d8ddf644103d4bde56ed239753f0bdb92ba9361d51905
ARG DENO_SHA256_AMD64=e890975bc2549807bbcc0b584ffafda72cc7c93349dd99c80483dd784f6c4609
RUN if [ "${STREAMING}" = 1 ]; then \
        case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
            arm64) deno_arch=aarch64; deno_sha256="${DENO_SHA256_ARM64}" ;; \
            amd64) deno_arch=x86_64; deno_sha256="${DENO_SHA256_AMD64}" ;; \
            *) echo "no deno digest for this architecture" >&2; exit 1 ;; \
        esac \
        && curl -fsSLo /tmp/deno.zip \
            https://github.com/denoland/deno/releases/download/v${DENO_VERSION}/deno-${deno_arch}-unknown-linux-gnu.zip \
        && echo "${deno_sha256}  /tmp/deno.zip" | sha256sum -c - \
        && python -c "import zipfile; zipfile.ZipFile('/tmp/deno.zip').extractall('/usr/local/bin')" \
        && chmod +x /usr/local/bin/deno && rm /tmp/deno.zip \
        && deno --version; \
    fi

# PostgreSQL 18 client — pg_dump / pg_restore for node backups (backup.py);
# jammy's own client is the 14 series, which cannot dump an 18 server.
# The repository's key is checked like any download (its fingerprint is
# B97B 0AFC AA1A 47F0 44F2 44A0 7FCC 7D46 ACCC 4CF8).
ARG PGDG_SIGNER_SHA256=0144068502a1eddd2a0280ede10ef607d1ec592ce819940991203941564e8e76
RUN apt-get update && apt-get install -y --no-install-recommends gnupg ca-certificates curl \
    && curl -fsSLo /tmp/pgdg.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc \
    && echo "${PGDG_SIGNER_SHA256}  /tmp/pgdg.asc" | sha256sum -c - \
    && gpg --dearmor -o /usr/share/keyrings/postgresql.gpg /tmp/pgdg.asc && rm /tmp/pgdg.asc \
    && echo "deb [signed-by=/usr/share/keyrings/postgresql.gpg] https://apt.postgresql.org/pub/repos/apt jammy-pgdg main" \
         > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update && apt-get install -y --no-install-recommends postgresql-client-18 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
ENV PG_BIN=/usr/lib/postgresql/18/bin

# The node reads no bytecode it cannot write (PI-NODE-2A). /app is the
# checkout's backend/, read-only to the node: a .pyc beside its sources — a
# host interpreter's, or one a node left before that mount — would be read
# for as long as its source keeps its mtime, an update included. Every
# interpreter of the image but node_user.py's (isolated, -I) keeps its cache
# under this prefix instead: the libraries' compiled here, root's, and the
# node's own modules compiled as they are imported, written nowhere. A
# library file that does not compile on 3.11 (torch ships 3.12 syntax among
# its tests) is one nothing imports.
ENV PYTHONPYCACHEPREFIX=/usr/local/lib/sautium/pycache
RUN python -c "import compileall, sys; [compileall.compile_dir(p, quiet=1, workers=0) for p in sys.path if p.startswith('/usr/') and p.endswith(('python3.11', 'site-packages'))]" \
    && test -d /usr/local/lib/sautium/pycache/usr/local/lib/python3.11/site-packages

# Copy application code
COPY . .

# Expose FastAPI port and DHT UDP port
EXPOSE 8000
EXPOSE 19001/udp

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Health check — the Web UI rides plain HTTP (no certificate to skip)
# (a path of its own, whose access line the node leaves out of its log)
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://127.0.0.1:${UVICORN_PORT:-8000}/healthz || exit 1

# Default command (can be overridden in docker-compose.yml)
CMD ["python", "entrypoint.py"]
