# Data directories (keep structure, exclude content)
data/postgres/*
!data/postgres/.gitkeep
data/cache/*
!data/cache/.gitkeep
# TLS cert + key — generated per-host on first backend start
data/tls/
data/authority/
# Claude Code session storage — bind-mounted so chat history survives rebuilds
data/claude_sessions/
# MusicBrainz dump (~7GB tarball + extracted TSVs) — re-downloadable, loaded into pg
data/mbdump/

# HMAC API secret — generated per-instance at backend startup
backend/data/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Testing
.pytest_cache/
.coverage
htmlcov/

# Model checkpoints (if stored locally)
*.pth
*.bin
*.ckpt
/prompt.txt
/backend/.cache
/tmp/
/pgsql/
/python312/

# MCP configs (contain passwords and API keys)
.mcp.json
backend/mcp-windows.json
backend/mcp-docker.json
backend/mcp-wsl.json

# Claude Code local settings (contain permissions with passwords)
.claude/settings.local.json

# PyInstaller
*.spec
/worker/.wrangler/cache/

# Bring-your-own streaming provider plugins (closed-repo, §1201 — Deezer etc.).
# Each is the user's OWN private repo cloned in here; never tracked by Sautium.
backend/streaming/providers/
