# Data directories. Every folder a container writes is ignored WHOLE — never
# `folder/*` with a keep-file beside it: git then never looks inside, so
# nothing the node writes there is a change to the checkout, and an update
# that refuses a changed checkout cannot be stopped from inside a container
# (PI-NODE-2A). Docker makes the ones that are missing.
# Docker volume, root-owned on the host — compose creates it
data/postgres/
data/cache/
# The empty folder that stands at /music on a node that reads its music under
# roots (./sautium writes MUSIC_LIBRARY_PATH to it)
data/no-library/
# Runtime caches and generated presets
data/registry/
data/generated_eq/
# TLS cert + key — generated per-host on first backend start
data/tls/
data/authority/
data/node_identity/
# Support desk — bundles user nodes sent, unpacked on demand (master only)
data/support/
# Claude Code session storage — bind-mounted so chat history survives rebuilds
data/claude_sessions/
# The node's Claude Code folder (every compose file since B-94): its sign-in, and on the Linux file its sessions
data/claude/
# The node's Codex folder (B-94)
data/codex/
# MusicBrainz dump (~7GB tarball + extracted TSVs) — re-downloadable, loaded into pg
data/mbdump/
# ListenBrainz statistics dump (~21 GB archive) — re-downloadable, aggregated into pg
data/lbdump/

# The node's own files in a Docker node's /app/data (its key, the transcode
# cache, the API secret where it used to live) — a bind of its own
backend/data/
# The host agent's (scripts/host_agent.py): ./host/ is bound into no
# container; ./run/requests is the one folder a container writes there
/host/
/run/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Testing
.pytest_cache/
.coverage
htmlcov/

# Model checkpoints (if stored locally)
*.pth
*.bin
*.ckpt
/prompt.txt
/backend/.cache
/tmp/
/pgsql/
/python312/
# Media tools and Node the launcher bootstraps into the project root (desktop/db_init.py)
/ffmpeg/
/fpcalc/
/flac/
/yt-dlp/
/deno/
/node/

# MCP configs (contain passwords and API keys)
.mcp.json
backend/mcp-windows.json
backend/mcp-docker.json
backend/mcp-wsl.json

# Claude Code local settings (contain permissions with passwords)
**/.claude/settings.local.json

# PyInstaller
*.spec
# Wrangler local state and secrets
/worker/.wrangler/
/worker/.dev.vars

# Bring-your-own streaming provider plugins — out of tree; DRM providers are never bundled.
# Each is the user's OWN private repo cloned in here; never tracked by Sautium.
backend/streaming/providers/

# Master front (scripts/master-front): pinned binaries fetched by install.ps1,
# WinSW service state and logs — only Caddyfile, the service XML and the
# script are source
scripts/master-front/*.exe
scripts/master-front/*.zip
scripts/master-front/*.download
scripts/master-front/caddy.unzip/
scripts/master-front/*.log

# pre-migration pg_dump snapshots (multi-GB) + node backups; share exports
data/backup/
data/export/
# the cold-start seed bundle: a GitHub Release asset downloaded on first start,
# never in the tree (backend/seed/bundle.json carries its digest)
data/seed/
backend/seed/*.json.gz
# The node's own copy of the HQPlayer atlas (backend/hqp_atlas.py) stays on
# the node. The shipped file and its version (scripts/sync-atlas.sh) are in
# the tree since the atlas's first release, 2026-11-19.
data/atlas/
# the sync's staging files, left behind only when it is killed
backend/.hqp_atlas*
# An identity file holds a node's private key: never a file of the tree
*.sautium-identity
