# Sautium master — the trusted front in front of the Docker peer surface.
#
# Docker Desktop (Windows/macOS) forwards every published port through
# user-space hops that rewrite the source address, so the container sees all
# peers as the bridge gateway: no addr/subnet axes for similarity, a
# per-address backstop that is really a global one, a probe-connect that
# calls back the wrong host. This front terminates the peer TLS on the host,
# forwards plain HTTP to the loopback-only upstream and stamps
# X-Forwarded-For; the container runs with P2P_TRUSTED_FRONT=1 and takes the
# peer's address from that header — for signals only, never for auth
# (CLAUDE.md, Security Posture rule #5).
#
# Invariant: the upstream below is published on 127.0.0.1 ONLY
# (P2P_SYNC_PUBLISH=127.0.0.1:18801 in .env). A directly reachable upstream
# would let anyone set X-Forwarded-For. Incoming X-Forwarded-For from peers
# is discarded by Caddy (no trusted_proxies configured) — verified.
#
# Nothing else lives here on purpose: no rate limits, no auth, no caching.
# Policy stays in backend/p2p_app.py, the single source of truth for the
# peer surface. Paths are relative to this directory, which is the service's
# working directory (sautium-front.xml).
{
	admin off
	auto_https off
	servers {
		protocols h1 h2
	}
}

https://:8801 {
	# The peer surface's own self-signed certificate (data/tls, generated by
	# backend/tls_gen.py, 10-year validity). Peers verify no chain, but they
	# DO pin the channel: the cert carries the node-key binding extension
	# (desktop/p2p/peer_auth.py — the master's Ed25519 signature over this
	# cert's TLS key), so serving an unbound or foreign cert here makes every
	# updated peer refuse the connection. After the backend regenerates the
	# cert (identity change, new SAN IP), restart this service to pick it up.
	# A hostless site serves this one certificate to clients without SNI —
	# which is what aiohttp/httpx send when they connect by IP.
	tls ../../data/tls/cert.pem ../../data/tls/key.pem
	reverse_proxy 127.0.0.1:18801
}
